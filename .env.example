# ==========================================
# Source2Deploy Local Environment Variables
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Service Ports
GATEWAY_PORT=8080
PROJECT_SERVICE_PORT=8081
DEPLOYMENT_SERVICE_PORT=8082
ANALYZER_SERVICE_PORT=8083
BUILD_SERVICE_PORT=8084
REGISTRY_SERVICE_PORT=8085
INFRASTRUCTURE_SERVICE_PORT=8086
DEPLOY_SERVICE_PORT=8087
MONITORING_SERVICE_PORT=8088

# Service URLs for Gateway Routing
PROJECT_SERVICE_URL=http://project-service:8081
DEPLOYMENT_SERVICE_URL=http://deployment-service:8082
ANALYZER_SERVICE_URL=http://analyzer-service:8083
BUILD_SERVICE_URL=http://build-service:8084
REGISTRY_SERVICE_URL=http://registry-service:8085
INFRASTRUCTURE_SERVICE_URL=http://infrastructure-service:8086
DEPLOY_SERVICE_URL=http://deploy-service:8087
MONITORING_SERVICE_URL=http://monitoring-service:8088

# Cloud & Security Placeholders (Override in local.env / secret store)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GITHUB_TOKEN=

# Auth Service local Compose settings
AUTH_PORT=8089
AUTH_ISSUER=http://localhost:8089
AUTH_AUDIENCE=source2deploy-api
AUTH_DB_USERNAME=auth
AUTH_DB_PASSWORD=auth-local-only
AUTH_DEV_CLIENT_ID=source2deploy-web
AUTH_DEV_REDIRECT_URIS=http://localhost:5173/callback
AUTH_DEV_POST_LOGOUT_URIS=http://localhost:5173/
AUTH_DEV_CLIENT_CONSENT=false
AUTH_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
AUTH_ACCESS_LIFETIME=5m
AUTH_REFRESH_LIFETIME=8h
AUTH_CODE_LIFETIME=2m

# Optional account recovery for local Compose
AUTH_RECOVERY_ENABLED=false
AUTH_MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Host or production runtime settings
# AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
# AUTH_SIGNING_KEY=/run/secrets/auth-signing.key
# AUTH_PREVIOUS_KEYS=/run/secrets/auth-previous.jwks
# AUTH_JWKS_URI=https://auth.example.com/oauth2/jwks
