# ==========================================
# Source2Deploy Local Environment Variables
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Service Ports
GATEWAY_PORT=8080
PROJECT_SERVICE_PORT=8081
DEPLOYMENT_SERVICE_PORT=8082
ANALYZER_SERVICE_PORT=8083
BUILD_SERVICE_PORT=8084
REGISTRY_SERVICE_PORT=8085
INFRASTRUCTURE_SERVICE_PORT=8086
DEPLOY_SERVICE_PORT=8087
MONITORING_SERVICE_PORT=8088

# Service URLs for Gateway Routing
PROJECT_SERVICE_URL=http://project-service:8081
DEPLOYMENT_SERVICE_URL=http://deployment-service:8082
ANALYZER_SERVICE_URL=http://analyzer-service:8083
BUILD_SERVICE_URL=http://build-service:8084
REGISTRY_SERVICE_URL=http://registry-service:8085
INFRASTRUCTURE_SERVICE_URL=http://infrastructure-service:8086
DEPLOY_SERVICE_URL=http://deploy-service:8087
MONITORING_SERVICE_URL=http://monitoring-service:8088

# Cloud & Security Placeholders (Override in local.env / secret store)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GITHUB_TOKEN=
JWT_SECRET=change-me-to-a-very-secure-256-bit-secret-key-for-local-development
