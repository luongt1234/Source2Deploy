# ==============================================================================
# Source2Deploy - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Java & Maven Build Outputs
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven Wrapper
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ------------------------------------------------------------------------------
# 2. IDEs and Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
gen/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.apt_generated_test
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbproject/load-impl.xml
nbproject/build-impl.xml

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!.env.example
!*.env.example

# Private keys and certificates
*.pem
*.key
*.keystore
*.jks
*.p12
*.cert
*.crt

# ------------------------------------------------------------------------------
# 4. Frontend & Node.js (React / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dist/
**/build/
.next/
.nuxt/
.cache/

# ------------------------------------------------------------------------------
# 5. Infrastructure & Cloud (Terraform / AWS / Docker)
# ------------------------------------------------------------------------------
# Local Docker Compose override
docker-compose.override.yml

# Terraform state and credentials
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ------------------------------------------------------------------------------
# 6. Operating System & Logs
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Local auth signing material
/auth-secrets/
